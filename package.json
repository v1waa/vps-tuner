{
  "name": "vps-tuner",
  "version": "0.1.0",
  "description": "Desktop SSH control center for Linux VPS",
  "author": "v1waa",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke-ui.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "io.github.v1waa.vpstuner",
    "productName": "VPS Tuner",
    "artifactName": "VPS-Tuner-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "System",
      "icon": "build/icon.png",
      "maintainer": "v1waa"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VPS-Tuner-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "VPS-Tuner-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
